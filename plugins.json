      "author": "Qomicex",
      "icon": "data:image/svg+xml;base64,",
      "version": "1.0.0",
      "minLauncherVersion": "0.1.0",
      "permissions": [
        "ui:toast"
      ],
      "tags": [
        "娱乐"
      ],
      "downloadUrl": "https://raw.githubusercontent.com/Qomicex-Public/Qomicex.Plugin-Market/repository/packages/com.qomicex.launch-meme.qplugin"
    },
    {
