      "icon": "data:image/svg+xml;base64,",
      "version": "1.2.0",
      "minLauncherVersion": "0.1.0",
      "permissions": [
        "config:write"
      ],
      "tags": [
        "Libraries"
      ],
      "downloadUrl": "https://raw.githubusercontent.com/Qomicex-Public/Qomicex.Plugin-Market/repository/packages/top.qomicex.markdown.qplugin"
    },
    {
      "id": "com.qomicex.launch-meme",
